{
  "name": "pmwallets",
  "version": "0.6.2",
  "description": "Official PMWallets SDK and CLI: Polymarket smart-money leaderboard, real-time wallet fills over WebSocket with gap replay, webhooks, exports — and a CLI + MCP server so AI agents (Claude Code, Codex, Cursor, …) can follow traders and act on their fills.",
  "mcpName": "io.github.polymarketwallets/pmwallets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pmwallets": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "polymarket",
    "copy-trading",
    "wallet-tracker",
    "smart-money",
    "pmwallets",
    "prediction-markets",
    "mcp",
    "ai-agent",
    "claude-code",
    "codex"
  ],
  "homepage": "https://pmwallets.com/docs",
  "license": "MIT",
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "undici": "^6.29.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymarketwallets/pmwallets-node.git"
  },
  "bugs": {
    "url": "https://github.com/polymarketwallets/pmwallets-node/issues"
  }
}
